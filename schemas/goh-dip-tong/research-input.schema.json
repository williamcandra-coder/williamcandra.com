{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://williamcandra.com/schemas/goh-dip-tong/research-input.schema.json",
  "title": "Research input snapshot",
  "description": "The calculation-ready contract handed to the Stage 2 engine: everything known about one issuer at one instant, with every value carrying its own basis, unit, timestamps and quality. This is the ONLY shape Stage 2 should have to read. An LLM may explain a snapshot but must never be the source of the numbers in it.",
  "type": "object",
  "required": ["schemaVersion", "ticker", "snapshotAt", "identity", "facts", "disclaimers", "contentHash"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "ticker": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "snapshotAt": { "type": "string", "format": "date-time" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "required": ["name", "sectorCode", "industryCode", "modelFamily", "coverageStatus", "inIdx30"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "sectorCode": { "type": "string" },
        "sectorName": { "type": "string" },
        "industryCode": { "type": "string" },
        "industryName": { "type": "string" },
        "modelFamily": { "type": ["string", "null"] },
        "coverageStatus": { "type": "string", "enum": ["FULL_RESEARCH", "FINANCIALS", "ONBOARDING", "SUSPENDED"] },
        "inIdx30": { "type": "boolean" },
        "reportingCurrency": { "type": ["string", "null"], "enum": ["IDR", "USD", null] }
      }
    },
    "facts": {
      "type": "array",
      "description": "Latest valid revision per factKey. Superseded revisions stay in the fact store, not here.",
      "items": { "$ref": "#/$defs/snapshotFact" }
    },
    "marketContext": {
      "type": ["object", "null"],
      "description": "Null whenever market-data rights do not permit this use. The engine must handle null rather than assume a price exists.",
      "required": ["available", "reason"],
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "asOfDate": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
        "close": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"], "enum": ["IDR", "USD", null] },
        "rightsStatus": { "type": ["string", "null"] }
      }
    },
    "macroContext": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seriesId", "observationPeriod", "value", "missingReason", "unit", "publishedAt", "retrievedAt"],
        "additionalProperties": false,
        "properties": {
          "seriesId": { "type": "string" },
          "observationPeriod": { "type": "string", "description": "The period the observation describes - never conflated with when it was published." },
          "value": { "type": ["number", "null"] },
          "missingReason": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "releaseVintage": { "type": ["string", "null"] },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "retrievedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "recentEvents": { "type": "array", "items": { "type": "object" } },
    "quality": {
      "type": "object",
      "required": ["status", "completeness"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["VALID", "SUSPECT", "INVALID", "UNVALIDATED"] },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingCriticalMetrics": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disclaimers": {
      "type": "array",
      "minItems": 1,
      "description": "Must travel with the data all the way to the UI.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "snapshotFact": {
      "type": "object",
      "required": ["metric", "periodType", "periodEnd", "basis", "value", "missingReason", "unit", "qualityStatus"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "segment": {
          "type": ["string", "null"],
          "description": "Null for a consolidated figure; a segment code for segment-level detail. Optional, but without it a consolidated fact and a segment fact for the same metric and period are indistinguishable, and an engine cannot tell which one to value from.",
          "default": null
        },
        "periodType": { "type": "string" },
        "periodStart": { "type": ["string", "null"] },
        "periodEnd": { "type": "string" },
        "fiscalYear": { "type": ["integer", "null"] },
        "basis": {
          "type": "string",
          "enum": ["REPORTED", "RESTATED", "NORMALIZED", "DERIVED", "FORECAST", "MARKET_IMPLIED"]
        },
        "value": { "type": ["number", "null"] },
        "missingReason": { "type": ["string", "null"] },
        "unit": { "type": "string" },
        "currency": { "type": ["string", "null"] },
        "revision": { "type": ["integer", "null"] },
        "qualityStatus": { "type": "string", "enum": ["VALID", "SUSPECT", "INVALID", "UNVALIDATED"] },
        "sourceRef": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "retrievedAt": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "null" } }, "required": ["value"] },
          "then": { "properties": { "missingReason": { "type": "string" } }, "required": ["missingReason"] }
        }
      ]
    }
  }
}
