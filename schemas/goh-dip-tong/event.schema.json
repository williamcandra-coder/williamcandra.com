{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://williamcandra.com/schemas/goh-dip-tong/event.schema.json",
  "title": "Corporate event",
  "description": "A tracked corporate event with an explicit certainty status. The status vocabulary exists so a rumour is never rendered like a confirmed fact. Only OFFICIAL_DECISION and later may be treated as fact by the engine.",
  "type": "object",
  "required": ["eventId", "ticker", "eventType", "status", "observedAt", "source"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "eventType": {
      "type": "string",
      "enum": [
        "DIVIDEND",
        "SPLIT",
        "REVERSE_SPLIT",
        "RIGHTS_ISSUE",
        "BONUS_ISSUE",
        "BUYBACK",
        "SHARE_ISSUANCE",
        "MERGER",
        "ACQUISITION",
        "DIVESTMENT",
        "MANAGEMENT_CHANGE",
        "INDEX_MEMBERSHIP_CHANGE",
        "SUSPENSION",
        "DELISTING",
        "RESTATEMENT",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["RUMOR", "MEDIA_REPORT", "PROPOSAL", "OFFICIAL_DECISION", "IMPLEMENTED", "COMPANY_IMPACT_CONFIRMED"],
      "description": "Certainty ladder. Anything below OFFICIAL_DECISION is not a fact and must be labelled as such in the UI."
    },
    "statusHistory": {
      "type": "array",
      "description": "Append-only trail of how certainty evolved.",
      "items": {
        "type": "object",
        "required": ["status", "observedAt"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["RUMOR", "MEDIA_REPORT", "PROPOSAL", "OFFICIAL_DECISION", "IMPLEMENTED", "COMPANY_IMPACT_CONFIRMED"]
          },
          "observedAt": { "type": "string", "format": "date-time" },
          "disclosureId": { "type": ["string", "null"] }
        }
      }
    },
    "headline": { "type": ["string", "null"], "maxLength": 300 },
    "announcedAt": { "type": ["string", "null"], "format": "date-time" },
    "effectiveDate": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
    "exDate": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
    "recordDate": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
    "paymentDate": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
    "observedAt": { "type": "string", "format": "date-time" },
    "amount": { "type": ["number", "null"] },
    "amountUnit": { "type": ["string", "null"], "enum": ["IDR", "USD", "SHARES", "RATIO", null] },
    "ratio": { "type": ["string", "null"], "description": "Free-form action ratio such as '1:2' for a split." },
    "missingReason": {
      "oneOf": [
        { "type": "string", "enum": ["NOT_REPORTED", "EXTRACTION_FAILED", "SOURCE_UNAVAILABLE", "RIGHTS_WITHHELD", "PENDING_REVIEW"] },
        { "type": "null" }
      ]
    },
    "disclosureId": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "required": ["providerId", "retrievedAt", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "officialUrl": { "type": ["string", "null"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "PUBLIC_RAW_DATA_APPROVED",
            "PUBLIC_DERIVED_OUTPUT_APPROVED",
            "PUBLIC_METADATA_ONLY",
            "PRIVATE_RESEARCH_ONLY",
            "DISCOVERY_ONLY",
            "MANUAL_REVIEW_REQUIRED",
            "DISABLED"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A null amount must carry a reason.",
      "if": { "properties": { "amount": { "type": "null" } }, "required": ["amount"] },
      "then": { "properties": { "missingReason": { "type": ["string", "null"] } } }
    }
  ]
}
