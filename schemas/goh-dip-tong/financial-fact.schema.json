{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://williamcandra.com/schemas/goh-dip-tong/financial-fact.schema.json",
  "title": "Financial fact",
  "description": "One normalized financial fact for one issuer, one metric, one period, one revision. Stored as JSONL, one object per line. Restatements append a new revision; a prior revision is never overwritten or deleted.",
  "type": "object",
  "required": [
    "factKey",
    "ticker",
    "metric",
    "periodType",
    "periodStart",
    "periodEnd",
    "fiscalYear",
    "basis",
    "value",
    "missingReason",
    "unit",
    "currency",
    "scale",
    "revision",
    "qualityStatus",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "factKey": {
      "type": "string",
      "description": "Stable identity of the underlying fact, excluding revision: ticker|metric|periodType|periodEnd|segment (segment defaults to CONSOLIDATED). Records sharing a factKey are successive observations of the same fact, so a RESTATED revision supersedes the REPORTED one. Basis is deliberately not part of the key.",
      "minLength": 1
    },
    "ticker": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "metric": { "type": "string", "minLength": 1, "description": "Must exist in config/goh-dip-tong/metrics.yml." },
    "periodType": {
      "type": "string",
      "enum": ["FY", "Q1", "Q2", "Q3", "Q4", "H1", "H2", "YTD_Q1", "YTD_Q2", "YTD_Q3", "TTM", "POINT_IN_TIME"]
    },
    "periodStart": {
      "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }],
      "description": "Null for POINT_IN_TIME (instant) facts."
    },
    "periodEnd": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "fiscalYear": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "basis": {
      "type": "string",
      "enum": ["REPORTED", "RESTATED", "NORMALIZED", "DERIVED", "FORECAST", "MARKET_IMPLIED"],
      "description": "The disclosure class. The public product must visually separate these."
    },
    "value": {
      "type": ["number", "null"],
      "description": "Null means missing. A failed extraction is null with a missingReason - never zero."
    },
    "missingReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "NOT_REPORTED",
            "NOT_APPLICABLE_TO_MODEL",
            "EXTRACTION_FAILED",
            "SOURCE_UNAVAILABLE",
            "RIGHTS_WITHHELD",
            "INSUFFICIENT_PERIODS",
            "PENDING_REVIEW",
            "SUPERSEDED"
          ]
        },
        { "type": "null" }
      ]
    },
    "unit": { "type": "string", "enum": ["IDR", "USD", "SHARES", "RATIO", "PERCENT", "DAYS", "INDEX_POINTS"] },
    "currency": { "type": ["string", "null"], "enum": ["IDR", "USD", null] },
    "scale": {
      "type": "string",
      "enum": ["UNITS", "THOUSANDS", "MILLIONS", "BILLIONS", "TRILLIONS"],
      "description": "The scale AS REPORTED by the issuer. `value` is always already normalized to base units; this field preserves what the filing said."
    },
    "revision": { "type": "integer", "minimum": 1, "description": "1 for the first observation, incremented for each restatement." },
    "supersedes": { "type": ["integer", "null"], "description": "Revision number this record replaces." },
    "restatementOf": { "type": ["string", "null"], "description": "Source document reference of the filing being restated." },
    "qualityStatus": {
      "type": "string",
      "enum": ["VALID", "SUSPECT", "INVALID", "UNVALIDATED"]
    },
    "qualityFlags": { "type": "array", "items": { "type": "string" } },
    "conceptId": { "type": ["string", "null"], "description": "Taxonomy concept the value was extracted from." },
    "taxonomy": { "type": ["string", "null"] },
    "parserVersion": { "type": "string", "minLength": 1 },
    "statement": {
      "type": ["string", "null"],
      "enum": ["INCOME_STATEMENT", "BALANCE_SHEET", "CASH_FLOW", "EQUITY", "SEGMENT", "CAPITAL_STRUCTURE", "MARKET", null]
    },
    "segment": { "type": ["string", "null"] },
    "source": { "$ref": "#/$defs/source" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["providerId", "retrievedAt", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "documentRef": { "type": ["string", "null"], "description": "Stable disclosure id of the filing this came from." },
        "documentUrl": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"], "format": "date-time", "description": "Filing publication date - distinct from the business period." },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "PUBLIC_RAW_DATA_APPROVED",
            "PUBLIC_DERIVED_OUTPUT_APPROVED",
            "PUBLIC_METADATA_ONLY",
            "PRIVATE_RESEARCH_ONLY",
            "DISCOVERY_ONLY",
            "MANUAL_REVIEW_REQUIRED",
            "DISABLED"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A null value must always carry a reason. This is the missing-versus-zero control.",
      "if": { "properties": { "value": { "type": "null" } }, "required": ["value"] },
      "then": { "properties": { "missingReason": { "type": "string" } }, "required": ["missingReason"] }
    },
    {
      "description": "A present value must not also claim to be missing.",
      "if": { "properties": { "value": { "type": "number" } }, "required": ["value"] },
      "then": { "properties": { "missingReason": { "type": "null" } } }
    },
    {
      "description": "Duration periods need a start date; instants must not have one.",
      "if": { "properties": { "periodType": { "const": "POINT_IN_TIME" } }, "required": ["periodType"] },
      "then": { "properties": { "periodStart": { "type": "null" } } },
      "else": { "properties": { "periodStart": { "type": "string" } } }
    }
  ]
}
