{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://williamcandra.com/schemas/goh-dip-tong/idx30.schema.json",
  "title": "IDX30 active universe",
  "description": "Generated, validated and committed active IDX30 universe. Consumed directly by the Stage 3 Goh Dip Tong company picker. The UI must never hard-code a ticker list; it reads this file.",
  "type": "object",
  "required": [
    "schemaVersion",
    "indexCode",
    "effectiveFrom",
    "effectiveTo",
    "source",
    "constituents",
    "contentHash"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "indexCode": { "type": "string", "const": "IDX30" },
    "effectiveFrom": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effectiveTo": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ],
      "description": "Null while this membership period is still current."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "authoritative": {
      "type": "boolean",
      "description": "False when generated from a fixture or an unverified source. The UI must show a development-data notice when false."
    },
    "provenance": {
      "type": "string",
      "enum": ["LIVE", "FIXTURE", "MANUAL"],
      "description": "How this snapshot was obtained."
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "publishedAt", "retrievedAt", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "providerId": { "type": "string" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rightsStatus": { "$ref": "#/$defs/rightsStatus" }
      }
    },
    "constituents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/constituent" }
    },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "rightsStatus": {
      "type": "string",
      "enum": [
        "PUBLIC_RAW_DATA_APPROVED",
        "PUBLIC_DERIVED_OUTPUT_APPROVED",
        "PUBLIC_METADATA_ONLY",
        "PRIVATE_RESEARCH_ONLY",
        "DISCOVERY_ONLY",
        "MANUAL_REVIEW_REQUIRED",
        "DISABLED"
      ]
    },
    "constituent": {
      "type": "object",
      "required": [
        "ticker",
        "name",
        "sectorCode",
        "sectorName",
        "industryCode",
        "industryName",
        "modelFamily",
        "coverageStatus",
        "active",
        "enteredAt",
        "sourceRef"
      ],
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z]{4}$",
          "description": "IDX ticker code. Four uppercase letters."
        },
        "name": { "type": "string", "minLength": 1 },
        "sectorCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "sectorName": { "type": "string", "minLength": 1 },
        "industryCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "industryName": { "type": "string", "minLength": 1 },
        "modelFamily": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z0-9_]+$" },
            { "type": "null" }
          ],
          "description": "Null when no supported model covers this classification. Never substitute a generic model."
        },
        "coverageStatus": {
          "type": "string",
          "enum": ["FULL_RESEARCH", "FINANCIALS", "ONBOARDING", "SUSPENDED"]
        },
        "active": { "type": "boolean" },
        "enteredAt": {
          "oneOf": [
            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            { "type": "null" }
          ]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable reference back to the source record this constituent came from."
        }
      },
      "allOf": [
        {
          "description": "A null modelFamily forces ONBOARDING. Assigning a generic valuation model to an uncovered classification is forbidden.",
          "if": { "properties": { "modelFamily": { "type": "null" } }, "required": ["modelFamily"] },
          "then": { "properties": { "coverageStatus": { "const": "ONBOARDING" } } }
        }
      ]
    }
  }
}
