{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://williamcandra.com/schemas/goh-dip-tong/market-price.schema.json",
  "title": "Daily market price observation",
  "description": "One trading day for one ticker. Provider-neutral: no field names borrowed from any specific vendor. Publication is gated on the provider's rights status - a record whose provider is PRIVATE_RESEARCH_ONLY must never reach a git-tracked path.",
  "type": "object",
  "required": [
    "ticker",
    "tradingDate",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "currency",
    "missingReason",
    "corporateActionFlag",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "ticker": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "tradingDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "open": { "$ref": "#/$defs/price" },
    "high": { "$ref": "#/$defs/price" },
    "low": { "$ref": "#/$defs/price" },
    "close": { "$ref": "#/$defs/price" },
    "adjustedClose": {
      "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }],
      "description": "Populated ONLY when both the adjustment methodology and the provider's rights are documented. Null otherwise - never back-computed silently."
    },
    "adjustmentMethodology": {
      "type": ["string", "null"],
      "description": "Required whenever adjustedClose is non-null."
    },
    "volume": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
      "description": "Zero is a legitimate value here (a suspended or untraded day). Null means not reported."
    },
    "value": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }], "description": "Traded value in currency units." },
    "currency": { "type": "string", "enum": ["IDR", "USD"] },
    "missingReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["NOT_REPORTED", "EXTRACTION_FAILED", "SOURCE_UNAVAILABLE", "RIGHTS_WITHHELD", "PENDING_REVIEW", "TRADING_HALTED"]
        },
        { "type": "null" }
      ]
    },
    "corporateActionFlag": {
      "type": "string",
      "enum": ["NONE", "DIVIDEND", "SPLIT", "REVERSE_SPLIT", "RIGHTS_ISSUE", "BONUS_ISSUE", "SUSPENSION", "MULTIPLE"]
    },
    "qualityStatus": { "type": "string", "enum": ["VALID", "SUSPECT", "INVALID", "UNVALIDATED"] },
    "qualityFlags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["providerId", "retrievedAt", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "PUBLIC_RAW_DATA_APPROVED",
            "PUBLIC_DERIVED_OUTPUT_APPROVED",
            "PUBLIC_METADATA_ONLY",
            "PRIVATE_RESEARCH_ONLY",
            "DISCOVERY_ONLY",
            "MANUAL_REVIEW_REQUIRED",
            "DISABLED"
          ]
        }
      }
    }
  },
  "$defs": {
    "price": {
      "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }],
      "description": "A traded price is strictly positive. A failed extraction is null with a missingReason, never 0."
    }
  },
  "allOf": [
    {
      "description": "adjustedClose requires a documented methodology.",
      "if": { "properties": { "adjustedClose": { "type": "number" } }, "required": ["adjustedClose"] },
      "then": { "properties": { "adjustmentMethodology": { "type": "string", "minLength": 1 } }, "required": ["adjustmentMethodology"] }
    },
    {
      "description": "A null close must carry a reason.",
      "if": { "properties": { "close": { "type": "null" } }, "required": ["close"] },
      "then": { "properties": { "missingReason": { "type": "string" } }, "required": ["missingReason"] }
    }
  ]
}
